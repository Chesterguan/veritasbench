# VeritasBench environment configuration template.
#
# Copy this file to .env and fill in your API keys:
#     cp .env.example .env
#     $EDITOR .env
#
# .env is gitignored — never commit real keys. Never paste keys into chat.

# ─── Minimum keys for W3 benchmark runs (10 models via 2 aggregators) ──

# OpenRouter — covers: gpt-4o-mini, deepseek-v3, deepseek-r1, qwen3-max,
#   glm-46, kimi-k2, claude-sonnet-46, gemini-25-pro, meditron-70b.
# Sign up: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# SiliconFlow — covers: huatuogpt-ii, huatuogpt-o1 (Chinese medical).
# Sign up: https://siliconflow.cn
SILICONFLOW_API_KEY=

# ─── Baseline reproducibility (existing v1 results) ──

# OpenAI — required only if you want to re-run the GPT-4o-mini baseline
# directly (i.e., not via OpenRouter). Skip if you're only using OpenRouter.
OPENAI_API_KEY=

# ─── Optional native-SDK adapters (prompt/context caching) ──

# Anthropic — used only if you invoke examples/llm_anthropic.py directly
# instead of routing Claude through OpenRouter. Enables prompt caching,
# which cuts input-token cost by ~90% on repeated system-prompt calls.
ANTHROPIC_API_KEY=

# Google AI Studio — used only if you invoke examples/llm_gemini.py
# directly instead of routing Gemini through OpenRouter.
# Sign up: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── Runtime overrides (optional) ──

# Override the model being benchmarked without editing examples/providers.yaml.
# VERITASBENCH_MODEL=gpt-4o-mini

# Override the OpenAI-compat base URL (useful for a self-hosted vLLM, Ollama, etc.).
# OPENAI_BASE_URL=http://localhost:8000/v1
